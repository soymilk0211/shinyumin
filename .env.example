# ============================================================
# 環境變數範本
# ============================================================
# 這份檔案只有「欄位名稱」，沒有任何真正的鑰匙，可以安全地放進 GitHub。
#
# 實際使用時請複製一份改名為 .env.local，把值填進去。
# .env.local 已被 .gitignore 排除，不會上傳到 GitHub，也不要傳給任何人。
# ============================================================

# Supabase 專案網址。這不是機密，每一個瀏覽器請求都看得到。
NEXT_PUBLIC_SUPABASE_URL=https://pemiinvmlwbotmzzszpz.supabase.co

# 公開金鑰。Supabase 後台可能標示為 anon public 或 Publishable key。
# 這把鑰匙會出現在訪客的瀏覽器裡，等同公開 —— 它的安全性完全依賴資料庫的 RLS。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 最高權限金鑰。Supabase 後台標示為 service_role 或 Secret key。
# ⚠️ 這把鑰匙【繞過所有 RLS】，等於資料庫的萬能鑰匙。
#    只能放在這個檔案（伺服器端），絕不可加上 NEXT_PUBLIC_ 前綴、
#    絕不可進入 GitHub、絕不可貼進聊天視窗或傳給任何人。
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# LINE 訂單通知（第 5 步）
# ------------------------------------------------------------
# 這三個是「御茗內部通知」那個 LINE 官方帳號的設定，
# 【不是】業主現有的客服官方帳號 —— 那一個絕對不要動。
#
# 沒有填也沒關係：網站照常運作、訂單照常成立，只是不會推 LINE。

# LINE Developers → Messaging API → Channel access token（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers → Basic settings → Channel secret
# 用來驗證 webhook 的請求是不是真的來自 LINE。
LINE_CHANNEL_SECRET=

# 要推到哪個群組。
# 【LINE 後台沒有任何地方看得到這個 ID】—— 必須把機器人加進群組、
# 在群組裡講一句話，機器人會把 ID 回貼在群組裡（見 docs/step-5-line.md）。
LINE_GROUP_ID=

# ------------------------------------------------------------
# 後台密碼（第 6 步）
# ------------------------------------------------------------
# 業主登入 /admin 用的密碼。第一版只有一組密碼，沒有帳號。
#
# ⚠️ 沒有設定的話，後台【一律拒絕進入】（不是放行）。
# 請設一組長一點的，例如四個不相干的中文詞或十二個以上的英數字。
ADMIN_PASSWORD=

# 要不要讓 Google 等搜尋引擎收錄這個網站。
#
# 【正式開站之前請留空或設成 false】——
# 現在照片是佔位符、文案未定稿，被搜尋引擎抓進去之後，
# 就算日後改好了，搜尋結果也可能還顯示舊的、不完整的內容一段時間。
#
# 內容都定稿、要正式對外之後，把它設成 true 即可。
NEXT_PUBLIC_ALLOW_INDEXING=
